# Required. Signs admin sessions; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local Docker database; use separate credentials in production.
DATABASE_URL=postgresql://kg_eventplan:local-development-only@127.0.0.1:5433/kg_eventplan
# Only used on Vercel, where a linked Blob store provides it. Locally the season plan PDF
# is kept in data/sessionsplan.pdf and no token is needed.
# Required for admin invitations and password resets: the club's IONOS mailbox address and
# password. SMTP_HOST (default smtp.ionos.de) and SMTP_PORT (default 587) only need setting
# for local testing, e.g. with Mailpit on port 1025.
SMTP_USER=
SMTP_PASSWORD=
