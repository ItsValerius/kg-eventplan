# Required. Signs admin sessions; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local Docker database; use separate credentials in production.
DATABASE_URL=postgresql://kg_eventplan:local-development-only@127.0.0.1:5433/kg_eventplan
# Required for the season plan PDF. Provided automatically by a linked Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
