# Required. Signs admin sessions; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local Docker database; use separate credentials in production.
DATABASE_URL=postgresql://kg_eventplan:local-development-only@127.0.0.1:5433/kg_eventplan
# Only used on Vercel, where a linked Blob store provides it. Locally the season plan PDF
# is kept in data/sessionsplan.pdf and no token is needed.
# Email for admin invitations and password resets. Locally: the Mailpit container
# (`pnpm mail:up`, inbox at http://localhost:8025), which accepts any login. In production
# SMTP_USER and SMTP_PASSWORD are the club's IONOS mailbox and SMTP_HOST/SMTP_PORT are unset
# (defaults: smtp.ionos.de, 587).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=sessionsplan@localhost
SMTP_PASSWORD=local-development-only
